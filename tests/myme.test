test mime-14.0 {ticket 5f455d6343} -setup {
    set part  [myme::initialize \
		   -canonical application/x-simile \
		   -header [list "Content-Description" "Run Status"] \
		   -encoding base64 -string "This is a test"]
    set whole [myme::initialize -canonical multipart/mixed -parts [list $part]]

    set saved checkmime.msg
    set stm [open $saved w]
    myme::copymessage $whole $stm
    close $stm

} -body {
    set stm [open $saved r]
    set str [read $stm]
    close $stm
    set restore [myme::initialize -string $str]
} -cleanup {
    myme::finalize $restore
    file delete $saved
    unset part whole saved stm str
} -match glob -result "::myme::*"

# -------------------------------------------------------------------------
# Fixes made in the myme fork

proc headercount {msg name} {
    set head [lindex [split [string map {\r\n\r\n \x00} $msg] \x00] 0]
    llength [regexp -all -inline -nocase -line "^[string map {- \\-} $name]:" $head]
}

proc lines msg {
    split [string map {\r\n \n} $msg] \n
}

test myme-1.1 {single Content-Transfer-Encoding header: buildmessage, -encoding given} -body {
    lmap enc {7bit 8bit binary base64 quoted-printable} {
        set tok [myme::initialize -canonical {text/plain; charset="UTF-8"} -encoding $enc -string "hi\n"]
        try {
            list $enc [headercount [myme::buildmessage $tok] Content-Transfer-Encoding]
        } finally {
            myme::finalize $tok
        }
    }
} -result {{7bit 1} {8bit 1} {binary 1} {base64 1} {quoted-printable 1}}

test myme-1.2 {single Content-Transfer-Encoding header: buildmessage, -encoding inferred} -body {
    set tok [myme::initialize -canonical text/plain -string "[string repeat x 100]\n"]
    set msg [myme::buildmessage $tok]
    list [headercount $msg Content-Transfer-Encoding] [regexp -line {^Content-Transfer-Encoding: (.*)\r$} $msg - enc] $enc
} -cleanup {
    myme::finalize $tok
    unset -nocomplain tok msg enc
} -result {1 1 quoted-printable}

test myme-1.3 {single Content-Transfer-Encoding header: copymessage, multipart} -setup {
    set p1 [myme::initialize -canonical text/plain -encoding 8bit -string "one\n"]
    set p2 [myme::initialize -canonical application/octet-stream -encoding base64 -string "\x00\x01\x02"]
    set tok [myme::initialize -canonical multipart/mixed -parts [list $p1 $p2]]
    set fn [makeFile {} myme-1.3.msg]
} -body {
    set h [open $fn w]
    myme::copymessage $tok $h
    close $h
    set h [open $fn r]
    set msg [read $h]
    close $h
    regexp -all -line {^Content-Transfer-Encoding:} $msg
} -cleanup {
    myme::finalize $tok -subordinates all
    removeFile myme-1.3.msg
    unset -nocomplain p1 p2 tok fn h msg
} -result 2

test myme-2.1 {buildmessage: CRLF in the body isn't doubled (tcllib ticket 67ace2b948)} -setup {
    set tok [myme::initialize -canonical text/plain -encoding 8bit -string "a\r\nb\nc\r\n"]
} -body {
    set msg [myme::buildmessage $tok]
    string range $msg [string first \r\n\r\n $msg] end
} -cleanup {
    myme::finalize $tok
    unset -nocomplain tok msg
} -result "\r\n\r\na\r\nb\r\nc\r\n"

test myme-2.2 {copymessage to a crlf channel: CRLF in the body isn't doubled} -setup {
    set tok [myme::initialize -canonical text/plain -encoding 8bit -string "a\r\nb\n"]
    set fn [makeFile {} myme-2.2.msg]
} -body {
    set h [open $fn w]
    chan configure $h -translation crlf
    myme::copymessage $tok $h
    close $h
    set h [open $fn rb]
    set msg [read $h]
    close $h
    list [string match *\r\r* $msg] [string range $msg end-5 end]
} -cleanup {
    myme::finalize $tok
    removeFile myme-2.2.msg
    unset -nocomplain tok fn h msg
} -result [list 0 "a\r\nb\r\n"]

test myme-2.3 {buildmessage: binary content isn't translated} -setup {
    set tok [myme::initialize -canonical application/octet-stream -encoding binary -string "a\nb\r\n"]
} -body {
    string range [myme::buildmessage $tok] end-4 end
} -cleanup {
    myme::finalize $tok
    unset -nocomplain tok
} -result "a\nb\r\n"

test myme-2.4 {buildmessage from a file: CRLF split across read chunks isn't doubled} -setup {
    set fn [makeFile {} myme-2.4.txt]
    set h [open $fn wb]
    # The \r is the last byte of the first 32766 byte chunk
    puts -nonewline $h "[string repeat x 32765]\r\nend\r\n"
    close $h
    set tok [myme::initialize -canonical text/plain -encoding 8bit -file $fn]
} -body {
    set msg [myme::buildmessage $tok]
    list [string match *\r\r* $msg] [string range $msg end-6 end]
} -cleanup {
    myme::finalize $tok
    removeFile myme-2.4.txt
    unset -nocomplain fn h tok msg
} -result [list 0 "\r\nend\r\n"]

test myme-3.1 {base64 from a file spanning several read chunks: lines ≤ 76 and round trip} -setup {
    set fn [makeFile {} myme-3.1.bin]
    set data {}
    for {set i 0} {$i < 100000} {incr i} {
        append data [format %c [expr {($i * 7) & 0xff}]]
    }
    set h [open $fn wb]
    puts -nonewline $h $data
    close $h
    set tok [myme::initialize -canonical application/octet-stream -encoding base64 -file $fn]
} -body {
    set msg [myme::buildmessage $tok]
    set body [string range $msg [expr {[string first \r\n\r\n $msg] + 4}] end]
    set long [lmap line [lines $body] {
        if {[string length $line] <= 76} continue
        set line
    }]
    set tok2 [myme::initialize -string $msg]
    list [llength $long] [expr {[myme::getbody $tok2] eq $data}]
} -cleanup {
    myme::finalize $tok
    myme::finalize $tok2
    removeFile myme-3.1.bin
    unset -nocomplain fn data i h tok tok2 msg body long
} -result {0 1}

test myme-4.1 {generated multipart boundaries are distinct and round trip} -setup {
    set toks {}
    foreach n {1 2} {
        set p [myme::initialize -canonical text/plain -string "part $n\n"]
        lappend toks [myme::initialize -canonical multipart/mixed -parts [list $p]]
    }
} -body {
    set msgs [lmap tok $toks {myme::buildmessage $tok}]
    set boundaries [lmap msg $msgs {
        regexp {boundary="([^"]+)"} $msg - b
        set b
    }]
    set bodies [lmap msg $msgs {
        set t [myme::initialize -string $msg]
        set body [string trim [myme::getbody [lindex [myme::getproperty $t parts] 0]]]
        myme::finalize $t -subordinates all
        set body
    }]
    list [expr {[lindex $boundaries 0] ne [lindex $boundaries 1]}] $bodies
} -cleanup {
    foreach tok $toks {myme::finalize $tok -subordinates all}
    unset -nocomplain toks n p tok msgs msg boundaries b bodies t body
} -result {1 {{part 1} {part 2}}}

test myme-6.1 {parsing doesn't depend on ::errorCode existing (tcllib ticket 0534941436)} -body {
    set i [interp create]
    try {
        $i eval [list ::tcl::tm::path add {*}[lreverse [::tcl::tm::path list]]]
        $i eval [list package require myme [package provide myme]]
        $i eval {
            unset -nocomplain ::errorCode ::errorInfo
            set t [myme::initialize -string "MIME-Version: 1.0\nContent-Type: multipart/mixed; boundary=SEP\n\n--SEP\nContent-Type: text/plain\n\nbody\n--SEP--\n"]
            list [myme::getproperty $t content] [llength [myme::getproperty $t parts]]
        }
    } finally {
        interp delete $i
    }
} -result {multipart/mixed 1}

test myme-6.2 {encodingasciiP: CR only at the end of a line (tcllib ticket f44bcbf068)} -body {
    list [myme::encodingasciiP "Simple line\r"] [myme::encodingasciiP "a\rb"]
} -result {1 0}

test myme-6.3 {encodingasciiP: characters above U+00FF aren't ASCII} -body {
    myme::encodingasciiP "Ł"
} -result 0

test myme-6.4 {CRLF text without -encoding needs no Content-Transfer-Encoding} -setup {
    set tok [myme::initialize -canonical text/plain -string "a\r\nb\r\n"]
} -body {
    set msg [myme::buildmessage $tok]
    list [headercount $msg Content-Transfer-Encoding] [string range $msg end-5 end]
} -cleanup {
    myme::finalize $tok
    unset -nocomplain tok msg
} -result [list 0 "a\r\nb\r\n"]

test myme-6.5 {quoted-printable text: CRLF line breaks are hard breaks, not =0D} -setup {
    set tok [myme::initialize -canonical text/plain -encoding quoted-printable -string "a\r\nb\n"]
} -body {
    set msg [myme::buildmessage $tok]
    string range $msg [string first \r\n\r\n $msg] end
} -cleanup {
    myme::finalize $tok
    unset -nocomplain tok msg
} -result "\r\n\r\na\r\nb\r\n"

test myme-6.6 {non-ASCII text without -encoding isn't sent as implicit 7bit} -body {
    lmap params {{} {-param {charset iso-8859-1}} {-param {charset utf-8}}} {
        set tok [myme::initialize -canonical text/plain {*}$params -string "caf\xe9\n"]
        try {
            regexp -line {^Content-Transfer-Encoding: (.*)\r$} [myme::buildmessage $tok] - enc
            set enc
        } finally {
            myme::finalize $tok
            unset -nocomplain enc
        }
    }
} -result {quoted-printable quoted-printable base64}

test myme-6.7 {parsed message without Content-Transfer-Encoding: none invented on output (tcllib ticket f44bcbf068)} -setup {
    set raw "Content-Type: text/plain\n\n[string repeat x 100]\n"
    set tok [myme::initialize -string $raw]
} -body {
    set msg [myme::buildmessage $tok]
    list [headercount $msg Content-Transfer-Encoding] [expr {[string trim [myme::getbody [set tok2 [myme::initialize -string $msg]]]] eq [string repeat x 100]}]
} -cleanup {
    myme::finalize $tok
    myme::finalize $tok2
    unset -nocomplain raw tok tok2 msg
} -result {0 1}

test myme-6.8 {parsed message with an unrecognised Content-Transfer-Encoding can be rebuilt} -setup {
    set tok [myme::initialize -string "Content-Type: application/octet-stream\nContent-Transfer-Encoding: x-uuencode\n\nbegin 644 x\n`\nend\n"]
} -body {
    regexp -line {^Content-Transfer-Encoding: x-uuencode\r$} [myme::buildmessage $tok]
} -cleanup {
    myme::finalize $tok
    unset -nocomplain tok
} -result 1

test myme-6.9 {field_decode keeps encoded trailing spaces (tcllib ticket d3f66f9a75)} -body {
    myme::field_decode "=?UTF-8?Q?Neuer_SPD-Generalsekret=C3=A4r_?=\n =?UTF-8?Q?Kl=C3=BCssendorf_warnt_Union_vor_?=\n =?UTF-8?Q?Konflikt_bei_Migration?="
} -result "Neuer SPD-Generalsekretär Klüssendorf warnt Union vor Konflikt bei Migration"

test myme-7.1 {parsedatetime zone: numeric zones, comments, large offsets, unknown zones (RFC 5322 3.3, 4.3)} -body {
    lmap z {-0700 +1400 +0530 {-0700 (PDT)} EST Z} {
        myme::parsedatetime "Thu, 08 Oct 2026 10:00:00 $z" zone
    }
} -result {-420 840 330 -420 -300 0}

test myme-7.2 {parsedatetime clock honours the numeric zone} -body {
    expr {
        [myme::parsedatetime "Thu, 08 Oct 2026 10:00:00 -0700 (PDT)" clock] -
        [myme::parsedatetime "Thu, 08 Oct 2026 17:00:00 +0000" clock]
    }
} -result 0

test myme-7.3 {parsedatetime lmonth spelling} -body {
    myme::parsedatetime "Tue, 08 Sep 2026 10:00:00 +0000" lmonth
} -result September

test myme-7.4 {qp_decode: CRLF soft line breaks and padding (RFC 2045 6.7 rules 3, 5)} -body {
    myme::qp_decode "abc=\r\ndef=3D  \r\nghi"
} -result "abcdef=\r\nghi"

test myme-7.5 {qp_encode: lone "." and "From " lines round trip} -body {
    lmap in [list "Hi\n.\nBye\n" "a\n.\n.\nb" ".\nFrom x" "x\x1fy"] {
        set e [myme::qp_encode $in]
        list $e [expr {[myme::qp_decode $e] eq $in}]
    }
} -cleanup {
    unset -nocomplain in e
} -result [list [list "Hi\n=2E\nBye\n" 1] [list "a\n=2E\n=2E\nb" 1] [list "=2E\n=46rom x" 1] [list x=1Fy 1]]

test myme-7.6 {Q encoded-words encode phrase specials (RFC 2047 5 (3))} -body {
    set w [myme::word_encode utf-8 quoted-printable "Smith, John (x) <y>; a.b:c" -charset_encoded 0]
    list $w [myme::field_decode $w]
} -cleanup {
    unset -nocomplain w
} -result {=?UTF-8?Q?Smith=2C_John_=28x=29_=3Cy=3E=3B_a=2Eb=3Ac?= {Smith, John (x) <y>; a.b:c}}

test myme-7.7 {multipart delimiters with transport padding (RFC 2046 5.1.1)} -setup {
    set tok [myme::initialize -string "Content-Type: multipart/mixed; boundary=B\n\n--B  \nContent-Type: text/plain\n\nx\n--B--\t\n"]
} -body {
    myme::getbody [lindex [myme::getproperty $tok parts] 0]
} -cleanup {
    myme::finalize $tok -subordinates all
    unset -nocomplain tok
} -result x

test myme-7.8 {parameter values: quoted-pairs escaped on output and undone on input, extended values unquoted} -setup {
    set tok [myme::initialize -canonical text/plain -param {name {a"b\c}} -param {title* utf-8''%E2%82%AC} -string x]
} -body {
    set msg [myme::buildmessage $tok]
    set tok2 [myme::initialize -string $msg]
    list [regexp {name="a\\"b\\\\c"} $msg] [regexp {title\*=utf-8''%E2%82%AC} $msg] [dictsort [myme::getproperty $tok2 params]]
} -cleanup {
    myme::finalize $tok
    myme::finalize $tok2
    unset -nocomplain tok tok2 msg
} -result {1 1 {name {a"b\c} title* utf-8''%E2%82%AC}}

test myme-7.9 {parameter values: unescaped backslashes in Windows paths are kept} -setup {
    set tok [myme::initialize -string "Content-Type: text/plain; name=\"C:\\dir\\f.txt\"\n\nx"]
} -body {
    dict get [myme::getproperty $tok params] name
} -cleanup {
    myme::finalize $tok
    unset -nocomplain tok
} -result {C:\dir\f.txt}

test myme-7.10 {multipart/digest parts default to message/rfc822 (RFC 2046 5.1.5)} -setup {
    set tok [myme::initialize -string "Content-Type: multipart/digest; boundary=B\n\n--B\n\nSubject: one\n\nbody1\n--B--\n"]
} -body {
    set part [lindex [myme::getproperty $tok parts] 0]
    list [myme::getproperty $part content] [myme::getheader [lindex [myme::getproperty $part parts] 0] subject]
} -cleanup {
    myme::finalize $tok -subordinates all
    unset -nocomplain tok part
} -result {message/rfc822 one}

test myme-7.11 {encoded-word charset with a language suffix (RFC 2231 5)} -body {
    myme::field_decode "=?UTF-8*en?Q?Hello?= world"
} -result {Hello world}

test myme-7.12 {Content-Transfer-Encoding with a comment and mixed case (RFC 2045 6.1)} -setup {
    set tok [myme::initialize -string "Content-Type: text/plain\nContent-Transfer-Encoding: Base64 (encoded)\n\naGVsbG8=\n"]
} -body {
    myme::getbody $tok
} -cleanup {
    myme::finalize $tok
    unset -nocomplain tok
} -result hello

test myme-7.13 {composite types only allow identity encodings (RFC 2045 6.4)} -body {
    myme::initialize -canonical message/rfc822 -encoding base64 -string "Subject: x\n\ny\n"
} -returnCodes error -result {-encoding base64 not allowed for message/rfc822}

test myme-5.1 {no tcllib dependencies loaded} -body {
    lmap pkg {base64 md5 tcl::chan::memchan tcl::chan::events tcl::chan::core Trf} {
        if {[package provide $pkg] eq {}} continue
        set pkg
    }
} -result {}

rename headercount {}
rename lines {}

